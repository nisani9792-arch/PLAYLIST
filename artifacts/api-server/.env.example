# Server
PORT=5000

# Meilisearch (required in production — search returns 503 until set)
# Rotate keys if a previous key was ever committed to git or logs.
MEILISEARCH_URL=https://your-meilisearch-host
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=music

# Optional: comma-separated browser origins allowed to call this API (omit in dev for permissive CORS)
# CORS_ORIGINS=https://your-frontend.example.com

# Behind nginx/terminating TLS: helps rate limiting use X-Forwarded-For correctly
# TRUST_PROXY=1

# Gemini (required for /api/gemini/* — server starts without these; routes return errors until set)
# On Render: Dashboard → Environment → add both keys.
# AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# AI_INTEGRATIONS_GEMINI_API_KEY=
