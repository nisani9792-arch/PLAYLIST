# =============================================================================
# Jusic CRM — production / deployment environment variables
# Copy this file to `.env` in the repository root and/or to
# `artifacts/api-server/.env` (loaded first when starting the API bundle).
# Never commit real secrets.
# =============================================================================

# ---------------------------------------------------------------------------
# API server (@workspace/api-server)
# ---------------------------------------------------------------------------

# Listening port for the Express app (required)
PORT=3000

# ---------------------------------------------------------------------------
# PostgreSQL — used by @workspace/db (Drizzle) and migrations / backup cron
# ---------------------------------------------------------------------------

# Connection URL (required for API features that touch the DB, migrations, backups)
DATABASE_URL=postgresql://user:password@db.example.com:5432/jusic_production

# ---------------------------------------------------------------------------
# Parasha song catalog (PSH.pdf) — used for פרשת שבוע playlist building
# ---------------------------------------------------------------------------

# Optional path to PSH.pdf on disk (default: artifacts/api-server/data/PSH.pdf in repo)
# PSH_PDF_PATH=/path/to/PSH.pdf

# ---------------------------------------------------------------------------
# Meilisearch — required for POST /api/search (music search proxy)
# ---------------------------------------------------------------------------

# Base URL of the Meilisearch instance (no trailing slash)
MEILISEARCH_URL=https://your-meilisearch.example.com

# API key with permission to search the target index (treat like a secret)
MEILISEARCH_API_KEY=

# Index UID to query (default in code: "music")
MEILISEARCH_INDEX=music

# Optional — forwarded to Meilisearch `filter` when set (JSON array of filter strings).
# If unset, search does not apply a filter (use when your index has no `type` field).
# MEILISEARCH_SEARCH_FILTERS=["type = SONG"]

# ---------------------------------------------------------------------------
# Google Gemini — required when lib/integrations-gemini-ai loads (e.g. /api/gemini)
# ---------------------------------------------------------------------------

AI_INTEGRATIONS_GEMINI_BASE_URL=
AI_INTEGRATIONS_GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Optional — operations & tuning
# ---------------------------------------------------------------------------

# NODE_ENV=production
# LOG_LEVEL=info

# Database backup cron (@workspace/api-server/src/lib/backup.ts)
# BACKUP_DIR=./backups
# BACKUP_RETAIN_COUNT=7
# BACKUP_CRON=0 2 * * *
# Absolute path if `pg_dump` is not on PATH (Linux: often /usr/bin/pg_dump)
# PG_DUMP_PATH=/usr/bin/pg_dump

# Helmet CSP — optional extra origins for connect-src (comma or space separated full URLs).
# MEILISEARCH_URL and AI_INTEGRATIONS_GEMINI_BASE_URL are included automatically when set.
# CSP_EXTRA_CONNECT_SRC=https://cdn.example.com https://streams.example.net

# In-memory search response cache (@workspace/api-server/src/lib/search-cache.ts)
# SEARCH_CACHE_MAX=200
# SEARCH_CACHE_TTL_MS=300000

# ---------------------------------------------------------------------------
# Frontend (@workspace/jusic) — if you inject build-time or dev proxy env
# ---------------------------------------------------------------------------

# Vite dev server port (optional; see artifacts/jusic/vite.config.ts)
# PORT=21378

# Public path when hosted under a sub-path
# BASE_PATH=/
